# ===================================================================
# CONFIGURACIÓN DE ENTORNO - UTTECAM API v2.0.0-secure
# ===================================================================
# Copia este archivo a .env y configura según tu entorno

# ===================================================================
# BASE DE DATOS MYSQL
# ===================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uttecam
DB_USER=root
DB_PASSWORD=

# ===================================================================
# SERVIDOR EXPRESS
# ===================================================================
PORT=3002
NODE_ENV=development

# ===================================================================
# SEGURIDAD JWT (OBLIGATORIO PARA v2.0)
# ===================================================================
# IMPORTANTE: Genera una clave robusta para producción
# Comando: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_clave_secreta_super_robusta_256_bits_minimo

# ===================================================================
# LOGGING Y MONITOREO
# ===================================================================
LOG_LEVEL=info
LOG_DIR=./logs

# ===================================================================
# CONFIGURACIÓN ADICIONAL (OPCIONAL)
# ===================================================================

# Configuración de CORS (dominios permitidos)
# CORS_ORIGINS=http://localhost:3000,https://uttecam.edu.mx

# Configuración de Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# Configuración de Upload de Archivos
# MAX_FILE_SIZE=5242880
# UPLOAD_PATH=./uploads

# ===================================================================
# CONFIGURACIONES DE PRODUCCIÓN
# ===================================================================

# Para SSL/HTTPS en producción
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Para base de datos en producción (ejemplo)
# DB_HOST=production-mysql-server.example.com
# DB_PORT=3306
# DB_NAME=uttecam_prod
# DB_USER=uttecam_prod_user
# DB_PASSWORD=password_super_segura_aqui

# ===================================================================
# CONFIGURACIÓN LEGACY (OPCIONAL)
# ===================================================================
SEQUELIZE_LOGGING=false

# ===================================================================
# NOTAS IMPORTANTES
# ===================================================================
# 
# 1. JWT_SECRET es OBLIGATORIO - sin él la API no iniciará
# 2. Cambia todas las contraseñas por defecto
# 3. En producción usa HTTPS siempre
# 4. Configura CORS_ORIGINS para tu dominio específico
# 5. Nunca subas este archivo a git con datos reales
# 6. Usa variables de entorno del servidor en producción
#
# ===================================================================
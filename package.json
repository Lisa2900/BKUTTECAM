{
  "name": "uttecam-api",
  "version": "2.0.0-secure",
  "description": "API CRUD para UTTECAM con Sequelize ORM, TypeScript y Seguridad OWASP Top 10",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npm run clean && tsc",
    "start": "node dist/server.js",
    "clean": "rimraf dist",
    "build:prod": "npm run build && node scripts/create-production-package.js",
    "deploy:prepare": "npm run build:prod && npm run deploy:zip",
    "deploy:zip": "echo 'Crear ZIP manualmente con: dist/, package.production.json, .env.example'",
    "db:reset": "ts-node -e \"require('./src/config/syncDatabase').syncDatabase(true)\"",
    "db:seed": "ts-node -e \"require('./src/config/syncDatabase').seedDatabase()\"",
    "seed:all": "node scripts/seed-all.js",
    "create:admin": "node scripts/create-admin.js",
    "test:files": "node scripts/test-files.js",
    "test:tokens": "node scripts/test-token-security.js",
    "seed:areas": "node scripts/seed-areas.js",
    "seed:nosotros": "node scripts/seed-nosotros.js",
    "seed:hero-slides": "node scripts/seed-hero-slides.js",
    "seed:evento": "node scripts/seed-evento.js",
    "security:test": "echo 'Testing security endpoints...' && curl -s http://localhost:3002/health",
    "lint": "echo 'Linting not configured yet'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "keywords": [
    "express",
    "typescript",
    "api",
    "uttecam"
  ],
  "author": "Universidad Tecnológica de Tecamachalco",
  "license": "MIT",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "express-slow-down": "^3.0.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.15.1",
    "sequelize": "^6.37.7",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.11.30",
    "@types/supertest": "^6.0.3",
    "axios": "^1.12.2",
    "jest": "^30.2.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}

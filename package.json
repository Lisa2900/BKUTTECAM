{
  "name": "uttecam-api",
  "version": "1.0.0",
  "description": "API CRUD textos para uttecam (Express + TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npm run clean && tsc",
    "start": "node dist/server.js",
    "clean": "rimraf dist",
    "build:prod": "npm run build && node scripts/create-production-package.js",
    "deploy:prepare": "npm run build:prod && npm run deploy:zip", 
    "deploy:zip": "echo 'Crear ZIP manualmente con: dist/, package.production.json, .env.example'",
    "db:reset": "ts-node -e \"require('./src/config/syncDatabase').syncDatabase(true)\"",
    "db:seed": "ts-node -e \"require('./src/config/syncDatabase').seedDatabase()\"",
    "lint": "echo 'Linting not configured yet'",
    "test": "echo 'Tests not configured yet'"
  },
  "keywords": [
    "express",
    "typescript",
    "api",
    "uttecam"
  ],
  "author": "Universidad Tecnológica de Tecamachalco",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "mysql2": "^3.15.1",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/sequelize": "^4.28.20",
    "rimraf": "^6.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}

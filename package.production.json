{
  "name": "uttecam-api",
  "version": "2.0.0",
  "description": "API REST para Universidad Tecnológica de Tecamachalco con Sequelize",
  "main": "dist/server.js",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "db:sync": "node -e \"require('./dist/config/syncDatabase').syncDatabase(false)\"",
    "health": "curl -f http://localhost:$PORT/health || exit 1",
    "logs": "tail -f logs/app.log"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.4.5",
    "sequelize": "^6.37.7",
    "mysql2": "^3.15.1",
    "compression": "^1.7.4",
    "express-rate-limit": "^6.10.0"
  },
  "keywords": [
    "api",
    "uttecam",
    "sequelize",
    "typescript",
    "universidad"
  ],
  "author": "Universidad Tecnológica de Tecamachalco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lisa2900/BKUTTECAM.git"
  }
}